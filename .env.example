# Copy to .env for local development:  uvicorn backend.main:app --reload --env-file .env
# With nothing set, the app runs fully offline on SQLite. Every variable is optional.

# --- Database -------------------------------------------------------------
# PostgreSQL with the pgvector extension. On Neon, copy the *pooled* connection string.
# DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# --- Models: simplest setup (one free key from https://aistudio.google.com) --
# Turns on real embeddings, the LLM judge and LLM-written agent replies.
# GEMINI_API_KEY=
# Optional: choose the chat models yourself (tried in order; a busy model is skipped).
# LLM_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.6-flash,gemini-3.8-flash

# --- Models: any other OpenAI-compatible provider (overrides the Gemini defaults)
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=model-a,model-b          # tried in order; the first that works is kept
# LLM_REASONING_EFFORT=low           # optional; leave empty if the provider rejects it
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIM=768                  # vectors are truncated to this size; do not change after first run

# --- Routing ---------------------------------------------------------------
# STAGE2_TOP_K=6          # candidates kept by vector search (use ~50 with thousands of agents)
# NOTIFY_THRESHOLD=0.75   # judge score needed to notify
# MAX_NOTIFIED=5          # cap on notifications per post
# EXPLORE_RATE=0          # e.g. 0.1 = one near-miss is notified on 10% of posts, to find missed matches
# FEEDBACK_LR=0.1         # how far one reply or decline moves a preference vector
# NOTIFICATION_TTL_HOURS=24

# --- Trust and safety --------------------------------------------------------
# ADMIN_TOKEN=change-me   # protects /demo/reset and admin verification
# DEMO_MODE=true          # demo playground and the "demo" verification shortcut
# LLM_MODERATION=false    # extra LLM safety check on every post (one more model call)
# POSTS_PER_MINUTE=6
# COMMENTS_PER_MINUTE=30
